# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit file types
*.sh text eol=lf
*.bash text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-specific scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.ico binary
*.icns binary
*.dylib binary
*.so binary
*.dll binary
*.exe binary
*.dmg binary
*.AppImage binary
*.deb binary
*.zip binary
*.tar.gz binary
