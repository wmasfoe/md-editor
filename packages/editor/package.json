{
  "name": "@md-editor/editor",
  "version": "0.2.2",
  "description": "A Markdown source and WYSIWYG editor built on CodeMirror 6, with an optional React adapter.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmasfoe/md-editor.git",
    "directory": "packages/editor"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./react": "./src/react/index.ts",
    "./react/testing": "./src/react/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node ../../scripts/packages/build.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "catalog:",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@lezer/common": "catalog:",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "catalog:",
    "@lezer/yaml": "^1.0.4",
    "@md-editor/core": "workspace:*",
    "@md-editor/markdown-fidelity": "workspace:*",
    "@md-editor/shared": "workspace:*",
    "markdownlint": "^0.42.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx-jsx": "^3.2.0",
    "micromark": "^4.0.2",
    "micromark-extension-cjk-friendly-util": "3.0.1",
    "micromark-extension-mdx-jsx": "^3.0.2",
    "micromark-extension-mdx-md": "2.0.0",
    "sanitize-html": "catalog:",
    "turndown": "catalog:",
    "turndown-plugin-gfm": "catalog:",
    "@md-editor/plugin-sdk": "workspace:^0.4.0",
    "@md-editor/plugin-host": "workspace:*"
  },
  "devDependencies": {
    "@types/markdownlint": "^0.18.0",
    "@types/sanitize-html": "catalog:",
    "@types/turndown": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "./react/testing": {
        "types": "./dist/react/testing.d.ts",
        "default": "./dist/react/testing.js"
      }
    }
  }
}
