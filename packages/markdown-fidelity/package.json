{
  "name": "@md-editor/markdown-fidelity",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node ../../scripts/packages/build.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@md-editor/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "description": "Markdown source preservation and round-trip utilities for Inkpoint.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmasfoe/md-editor.git",
    "directory": "packages/markdown-fidelity"
  },
  "bugs": {
    "url": "https://github.com/wmasfoe/md-editor/issues"
  }
}
