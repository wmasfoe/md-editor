{
  "name": "@md-editor/core",
  "version": "0.1.0",
  "description": "Headless Markdown document state, transactions, commands and editor runtime without DOM or UI dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmasfoe/md-editor.git",
    "directory": "packages/core"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node ../../scripts/packages/build.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@md-editor/shared": "workspace:*",
    "@md-editor/plugin-sdk": "workspace:^0.2.0"
  },
  "devDependencies": {
    "@md-editor/mdx-plugins": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
