{
  "name": "@md-editor/syntax-plugins",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./directive": "./src/directive/index.ts",
    "./math": "./src/math/index.ts",
    "./mermaid": "./src/mermaid/index.ts",
    "./metadata": "./src/metadata.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node ../../scripts/packages/build.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@lezer/common": "catalog:",
    "@lezer/markdown": "catalog:",
    "katex": "catalog:",
    "mermaid": "catalog:",
    "@md-editor/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "catalog:",
    "@md-editor/core": "workspace:*",
    "@md-editor/editor": "workspace:*",
    "@types/katex": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./directive": {
        "types": "./dist/directive/index.d.ts",
        "default": "./dist/directive/index.js"
      },
      "./math": {
        "types": "./dist/math/index.d.ts",
        "default": "./dist/math/index.js"
      },
      "./mermaid": {
        "types": "./dist/mermaid/index.d.ts",
        "default": "./dist/mermaid/index.js"
      },
      "./metadata": {
        "types": "./dist/metadata.d.ts",
        "default": "./dist/metadata.js"
      }
    }
  }
}
