{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/playground/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/playground/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/playground/plugin-guest.html",
      "destination": "/plugin-guest.html"
    },
    {
      "source": "/playground",
      "destination": "/index.html"
    },
    {
      "source": "/playground/",
      "destination": "/index.html"
    },
    {
      "source": "/playground/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:match*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/playground/assets/:match*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
