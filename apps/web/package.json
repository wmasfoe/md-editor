{
  "name": "@md-editor/web",
  "version": "0.3.1",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node ../../scripts/release/assert-no-sourcemaps.mjs dist",
    "preview": "vite preview",
    "deploy": "node ../../scripts/web/deploy-web.mjs",
    "release:web": "node ../../scripts/web/deploy-web.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@headlessui/react": "catalog:",
    "@heroicons/react": "catalog:",
    "@md-editor/ai": "workspace:*",
    "@md-editor/core": "workspace:*",
    "@md-editor/app-ui": "workspace:*",
    "@md-editor/file-system": "workspace:*",
    "@md-editor/i18n": "workspace:*",
    "@md-editor/markdown-fidelity": "workspace:*",
    "@md-editor/mdx-plugins": "workspace:*",
    "@md-editor/editor": "workspace:*",
    "@md-editor/shared": "workspace:*",
    "@md-editor/syntax-plugins": "workspace:*",
    "katex": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@md-editor/plugin-host": "workspace:*",
    "@md-editor/plugin-sdk": "workspace:*",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@lezer/common": "catalog:",
    "@lezer/markdown": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@playwright/test": "catalog:"
  }
}
