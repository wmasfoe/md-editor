#!/bin/sh
# Git pre-push hook: Enforce lint and test verification before pushing (only for AI Agent or opt-in)

# 开发者日常手动 push 时自动跳过耗时校验，秒推不阻塞；仅在 Agent 或显式开启时执行
if [ -z "$AGENT_ENV" ] && [ -z "$AI_AGENT" ] && [ -z "$ANTIGRAVITY_CLI" ] && [ -z "$CODEX_AGENT" ] && [ -z "$FORCE_PRE_PUSH" ]; then
  exit 0
fi

echo "🔍 [Pre-push Hook] Verifying code quality before pushing..."

echo "▶ 1/3 Running lint checks (pnpm lint)..."
pnpm lint
if [ $? -ne 0 ]; then
  echo "❌ [Pre-push Rejected] 'pnpm lint' failed. Please fix lint/format errors before pushing."
  exit 1
fi

echo "▶ 2/3 Running unit tests (pnpm test)..."
pnpm test
if [ $? -ne 0 ]; then
  echo "❌ [Pre-push Rejected] 'pnpm test' failed. Please fix failing tests before pushing."
  exit 1
fi

echo "▶ 3/3 Running typecheck (pnpm typecheck)..."
pnpm typecheck
if [ $? -ne 0 ]; then
  echo "❌ [Pre-push Rejected] 'pnpm typecheck' failed. Please fix TypeScript errors before pushing."
  exit 1
fi

echo "✅ [Pre-push Passed] All verification checks passed!"
exit 0
