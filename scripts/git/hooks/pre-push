#!/bin/sh
# Run the Cargo checks for agent pushes and opt-in developer pushes.

# 开发者日常手动 push 时自动跳过耗时校验，秒推不阻塞；仅在 Agent 或显式开启时执行
if [ -z "$AGENT_ENV" ] && [ -z "$AI_AGENT" ] && [ -z "$ANTIGRAVITY_CLI" ] && [ -z "$CODEX_AGENT" ] && [ -z "$FORCE_PRE_PUSH" ]; then
  exit 0
fi

set -e

cargo fmt --all --check
cargo clippy --workspace --all-targets --locked -- -D warnings
cargo test --workspace --locked
