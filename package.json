{
  "name": "md-editor",
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "description": "Inkpoint — a daily-usable Markdown and MDX-compatible desktop editor.",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev:desktop": "pnpm --filter @md-editor/desktop dev",
    "dev:web": "pnpm --filter @md-editor/web dev",
    "dev:utools": "pnpm --filter @md-editor/utools dev",
    "dev:site": "pnpm --filter @md-editor/site dev",
    "dev:ios": "node scripts/mobile/run-ios.mjs",
    "dev:android": "node scripts/mobile/run-android.mjs",
    "build:android": "node scripts/mobile/build-android-apk.mjs",
    "build:ios": "node scripts/mobile/build-ios-ipa.mjs",
    "tauri": "pnpm --filter @md-editor/desktop tauri",
    "dev:worker": "pnpm --filter @md-editor/distribution-worker run dev",
    "deploy:worker": "pnpm --filter @md-editor/distribution-worker run deploy",
    "build:web": "pnpm --filter @md-editor/web build",
    "build:mobile": "pnpm --filter @md-editor/mobile-core build && node scripts/mobile/sync-mobile-web.mjs",
    "build:utools": "pnpm --filter @md-editor/utools build",
    "build:site": "pnpm --filter @md-editor/site build",
    "build:macos": "pnpm --filter @md-editor/desktop tauri build --bundles dmg",
    "build:macos:release": "pnpm run build:macos:release:dmg && pnpm run build:macos:release:updater",
    "build:macos:release:dmg": "pnpm --filter @md-editor/desktop tauri build --bundles dmg --config src-tauri/tauri.release.conf.json",
    "build:macos:release:updater": "pnpm --filter @md-editor/desktop tauri build --bundles app --config src-tauri/tauri.release.conf.json",
    "build:linux": "node scripts/release/build-linux-bundle.mjs",
    "build:linux:release": "node scripts/release/build-linux-bundle.mjs --release",
    "build:windows": "pnpm --filter @md-editor/desktop tauri build --bundles nsis",
    "build:windows:release": "pnpm --filter @md-editor/desktop tauri build --bundles nsis --config src-tauri/tauri.release.conf.json",
    "release:desktop": "node scripts/release/publish-desktop.mjs",
    "release:desktop:version": "node scripts/release/version-desktop.mjs",
    "release:web": "node scripts/web/deploy-web.mjs",
    "release:web:publish": "node scripts/release/publish-web.mjs",
    "release:web:version": "node scripts/release/version-web.mjs",
    "release:packages": "node scripts/packages/publish.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "deploy:web": "node scripts/web/deploy-web.mjs",
    "release:site": "node scripts/site/deploy-site.mjs",
    "smoke:core": "node --experimental-strip-types scripts/smoke-core.mjs",
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r --sort typecheck",
    "verify": "pnpm lint && pnpm test && pnpm typecheck && pnpm verify:packages",
    "pr:watch": "node scripts/git/watch-pr.mjs",
    "prepare": "node scripts/git/install-hooks.mjs",
    "test": "pnpm -r --sort test && pnpm test:release && pnpm test:structure && pnpm test:style-eval && pnpm test:bundle && pnpm test:packages",
    "test:bundle": "node --test apps/desktop/scripts/bundle-budget.test.mjs && node apps/desktop/scripts/code-language-bundle-probe.mjs",
    "test:bundle:update": "node apps/desktop/scripts/code-language-bundle-probe.mjs --update-budget",
    "test:release": "node --test scripts/release/*.test.mjs scripts/mobile/*.test.mjs",
    "test:style-eval": "node --test scripts/style-eval/*.test.mjs",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "lint": "pnpm lint:oxlint && pnpm format:prettier:check && pnpm lint:structure && pnpm lint:rust",
    "lint:fix": "oxlint --fix . && prettier --write . && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "format:check": "pnpm format:prettier:check && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check",
    "format:prettier:check": "prettier --check .",
    "lint:structure": "node scripts/structure/check.mjs --phase pr3",
    "test:structure": "node --test scripts/structure/*.test.mjs",
    "build:packages": "pnpm --filter \"./packages/**\" -r --sort build",
    "test:packages": "node --test scripts/packages/*.test.mjs",
    "verify:packages": "pnpm build:packages && node scripts/packages/verify.mjs",
    "verify:editor-packages": "pnpm --filter-prod @md-editor/editor... -r --sort build && node scripts/packages/verify.mjs --package @md-editor/core --package @md-editor/editor"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "semver": "7.8.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
