# Dependencies
node_modules/
.pnpm-store/

# JavaScript / TypeScript build output
dist/
# Sentry 插件会自动读取这个文件里的 token，禁止入库。CI 只用 SENTRY_AUTH_TOKEN。
.env.sentry-build-plugin
build/
.next/
*.tsbuildinfo
.vite/
.turbo/
infra/distribution-worker/public/
# Vercel CLI link：只允许 monorepo 根 .vercel/（不要 apps/site/.vercel）
.vercel/*
!.vercel/project.json
apps/site/.vercel/

# Rust / Tauri build output
target/
src-tauri/target/
**/src-tauri/target/

# Swift / iOS / Android build output
.build/
**/.build/
**/*.xcodeproj/project.xcworkspace/
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/xcuserdata/
**/.gradle/
**/build/
**/assets/editor/
**/Resources/editor/
/inkpoint/

# Tauri generated files and local config
src-tauri/gen/
src-tauri/.cargo/
**/src-tauri/gen/
**/src-tauri/.cargo/
**/src-tauri/binaries/llama-server-*
!**/src-tauri/binaries/llama-server-aarch64-apple-darwin
**/src-tauri/binaries/tmp-llama-*
**/src-tauri/binaries/inkpoint-pdf-exporter

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/

# Cache
.cache/
.parcel-cache/
.wrangler/
**/.wrangler/

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Temporary files
tmp/
temp/
scratch/
dist-desktop/
dist-mobile/
.omx/
.omc/
.pi/
.agents/*
!.agents/skills/
!.agents/skills/**
.codex/*
!.codex/agents/
!.codex/agents/**
!.codex/prompts/
!.codex/prompts/**
*.bkup
**/src-tauri/binaries/*.so
**/src-tauri/binaries/*.dll
**/src-tauri/binaries/*.dylib

# macOS llama.cpp 运行时：只 vendor Tauri 真正打进包的 dylib（见 tauri.macos.conf.json
# 的 bundle.macOS.files）。其余同名多版本副本（*.dylib / *.0.dylib / *.0.0.9789.dylib）
# 以及 llama-cli/bench/quantize 等 CLI 工具库都不随包，由 prepare-llama-runtime.mjs
# 需要时下载，不进版本库。
**/src-tauri/binaries/llama-runtime-*/*.dylib
!**/src-tauri/binaries/llama-runtime-*/libggml-base.0.dylib
!**/src-tauri/binaries/llama-runtime-*/libggml-blas.0.dylib
!**/src-tauri/binaries/llama-runtime-*/libggml-cpu.0.dylib
!**/src-tauri/binaries/llama-runtime-*/libggml-metal.0.dylib
!**/src-tauri/binaries/llama-runtime-*/libggml-rpc.0.dylib
!**/src-tauri/binaries/llama-runtime-*/libggml.0.dylib
!**/src-tauri/binaries/llama-runtime-*/libllama-common.0.dylib
!**/src-tauri/binaries/llama-runtime-*/libllama-server-impl.dylib
!**/src-tauri/binaries/llama-runtime-*/libllama.0.dylib
!**/src-tauri/binaries/llama-runtime-*/libmtmd.0.dylib
style-eval-out/
