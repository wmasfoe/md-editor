# Dependencies
node_modules/
.pnpm-store/

# JavaScript / TypeScript build output
dist/
apps/desktop/editor-dist/
# Sentry 插件会自动读取这个文件里的 token，禁止入库。CI 只用 SENTRY_AUTH_TOKEN。
.env.sentry-build-plugin
build/
.next/
*.tsbuildinfo
.vite/
.turbo/
infra/distribution-worker/public/
# Vercel CLI link：只允许 monorepo 根 .vercel/（不要 apps/site/.vercel）
.vercel/*
!.vercel/project.json
apps/site/.vercel/

# Rust build output
target/
# Tauri 退役后 apps/desktop/src-tauri 只剩构建产物与生成的 schema，
# 没有源码。它们由旧构建留下，不应进入版本库或格式化检查。
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/binaries/

# Swift / iOS / Android build output
.build/
**/.build/
**/*.xcodeproj/project.xcworkspace/
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/xcuserdata/
**/.gradle/
**/build/
**/assets/editor/
**/Resources/editor/
/inkpoint/

# GPUI llama.cpp runtime: 运行时由 prepare-llama-runtime.mjs 下载/刷新。
# 只忽略下载器生成的顶层临时与平台二进制，已随仓库分发的 aarch64 payload 保持跟踪。
apps/desktop/runtime/llama/llama-server-*
!apps/desktop/runtime/llama/llama-server-aarch64-apple-darwin
apps/desktop/runtime/llama/tmp-llama-*
apps/desktop/runtime/llama/*.so
apps/desktop/runtime/llama/*.dll
apps/desktop/runtime/llama/*.dylib

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/

# Cache
.cache/
.parcel-cache/
.wrangler/
**/.wrangler/

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Temporary files
tmp/
temp/
scratch/
dist-desktop/
dist-mobile/
.omx/
.omc/
.pi/
.agents/*
!.agents/skills/
!.agents/skills/**
.codex/*
!.codex/agents/
!.codex/agents/**
!.codex/prompts/
!.codex/prompts/**
*.bkup
style-eval-out/
